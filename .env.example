PORT=5000
DATABASE_URL=
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT
SECRET_KEY=

# Cloudinary
API_KEY=
API_SECRET=
CLOUD_NAME=

# Email (Resend) - https://resend.com/api-keys
RESEND_API_KEY=
# Until you verify your own domain in Resend, only onboarding@resend.dev works,
# and it can deliver ONLY to the email address of your Resend account.
RESEND_FROM=Nestro <onboarding@resend.dev>
# Where messages from the website contact form are delivered
CONTACT_TO_EMAIL=

# First admin bootstrap (POST /api/user/seed-admin). Required in production.
ADMIN_EMAIL=admin@nestro.com
ADMIN_PASSWORD=
